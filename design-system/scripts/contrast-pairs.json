    { "use": "ui", "fg": "tag.improvement.fg", "bg": "surface.raised", "where": "punto de chip improvement" },
    { "use": "ui", "fg": "tag.bugfix.fg", "bg": "surface.raised", "where": "punto de chip bugfix" },
    { "use": "ui", "fg": "tag.technical.fg", "bg": "surface.raised", "where": "punto de chip technical" },
    { "use": "ui", "fg": "focus", "bg": "background", "where": "anillo de foco sobre página" },
    { "use": "ui", "fg": "focus", "bg": "surface.base", "where": "anillo de foco sobre columna" },
    { "use": "ui", "fg": "focus", "bg": "surface.raised", "where": "anillo de foco sobre tarjeta/diálogo" }
  ]
}
